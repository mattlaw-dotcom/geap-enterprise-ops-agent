# Copy to `.env` for local development. NEVER commit `.env` or real credentials.

# Google Cloud / Vertex AI Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
ADK_APP_NAME=geap_enterprise_ops_agent
APP_ENV=dev

# Model Routing (Flash for fast triage/synthesis, Pro for complex remediation planning)
ADK_FLASH_MODEL=gemini-2.5-flash
ADK_PRO_MODEL=gemini-2.5-pro

# Secret Manager (enable in GCP; locally falls back to environment variables)
USE_SECRET_MANAGER=false
SECRET_GEMINI_API_KEY_ID=gemini-api-key
SECRET_OPS_DB_URL_ID=ops-db-url
SECRET_PAGERDUTY_TOKEN_ID=pagerduty-webhook-secret

# Optional local dev key (for non-Vertex Gemini API testing only; keep empty in git)
GOOGLE_API_KEY=

# Persistent Session, Runbook, and Long-Term Memory Stores
OPS_DATABASE_URL=sqlite+aiosqlite:///./data/ops_sessions.db
OPS_KNOWLEDGE_DB_PATH=./data/ops_knowledge.db
OPS_MEMORY_DB_PATH=./data/ops_memory.db

# Optional Vertex AI Agent Engine & Model Armor IDs (populated after deployment)
AGENT_ENGINE_ID=
VERTEX_AI_DATASTORE_ID=
MODEL_ARMOR_TEMPLATE_ID=

# Observability & PII Redaction
ENABLE_CLOUD_DLP=false
ENABLE_OTEL_CLOUD_EXPORT=false
OTEL_EXPORTER_OTLP_ENDPOINT=
